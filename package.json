{
  "name": "gestor-actividades",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "evaluate:ai": "node --env-file-if-exists=.env scripts/evaluate-ai.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "instalar": "node inicializacion/01-instalar-dependencias.mjs",
    "arrancar": "node inicializacion/03-arrancar.mjs",
    "test": "node scripts/test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/check-boundaries.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "build:production": "npm run typecheck && node scripts/build.mjs --production",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3"
  }
}
