# La clave es exclusivamente del servidor; nunca se incluye en el build PWA.
DEV_HOST=127.0.0.1
DEV_PORT=3000
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_VOICE_MODEL=whisper-large-v3-turbo
AI_API_KEY=
# Alternativa Gemini: AI_PROVIDER=gemini y ambos modelos=gemini-3.8-flash.
# Diagnóstico explícito: contiene texto/candidatos personales, nunca la clave.
AI_DEBUG=false
# Solo cuando el proxy del túnel modifica Host: URL HTTPS exacta permitida.
AI_ALLOWED_ORIGIN=
