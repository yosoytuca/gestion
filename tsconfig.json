{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"], "strict": true, "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "esModuleInterop": true,
    "resolveJsonModule": true, "skipLibCheck": true, "noEmit": true,
    "jsx": "react-jsx", "jsxImportSource": "preact"
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "backend/**/*.ts", "datos/**/*.ts", "tests/**/*.ts", "tests/**/*.tsx"]
}
